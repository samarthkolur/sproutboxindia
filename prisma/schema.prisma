generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          Role        @default(GROWER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  grower        Grower?
  restaurant    Restaurant?
  sessions      Session[]
}

model Grower {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String
  address         String
  city            String
  pincode         String
  lat             Float?
  lng             Float?
  clusterId       String?
  kitSize         Int      @default(5)
  spaceAvailable  Int?
  spacePhotoUrl   String?
  bankAccount     String?
  bankIFSC        String?
  upiId           String?
  fssaiRegNumber  String?
  fssaiVerifiedAt DateTime?
  yieldScore      Float    @default(0.5)
  qualityScore    Float    @default(0.5)
  timelinessScore Float    @default(0.5)
  compositeScore  Float    @default(0.5)
  totalEarnings   Float    @default(0)
  isActive        Boolean  @default(true)
  joinedAt        DateTime @default(now())
  cluster         Cluster? @relation(fields: [clusterId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  payouts         Payout[]
  tasks           Task[]
}

model Restaurant {
  id               String     @id @default(cuid())
  userId           String     @unique
  businessName     String
  gstin            String?
  address          String
  city             String
  pincode          String
  lat              Float?
  lng              Float?
  contactName      String
  phone            String
  cuisineType      String?
  stripeCustomerId String?
  isActive         Boolean    @default(true)
  feedbacks        Feedback[]
  orders           Order[]
  user             User       @relation(fields: [userId], references: [id])
}

model Order {
  id              String          @id @default(cuid())
  restaurantId    String
  cropType        String
  quantityKg      Float
  deliveryDate    DateTime
  recurrence      String?
  status          OrderStatus     @default(PENDING_PAYMENT)
  totalPrice      Float
  stripePaymentId String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  delivery        Delivery?
  feedback        Feedback?
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])
  productionPlan  ProductionPlan?
}

model ProductionPlan {
  id            String   @id @default(cuid())
  orderId       String   @unique
  totalKg       Float
  totalTrays    Int
  bufferTrays   Int
  bufferPercent Float    @default(0.25)
  sowDate       DateTime
  harvestDate   DateTime
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])
  tasks         Task[]
}

model Task {
  id          String         @id @default(cuid())
  planId      String
  growerId    String
  cropType    String
  trayCount   Int
  sowDate     DateTime
  harvestDate DateTime
  status      TaskStatus     @default(ASSIGNED)
  allocatedAt DateTime       @default(now())
  batches     Batch[]
  grower      Grower         @relation(fields: [growerId], references: [id])
  plan        ProductionPlan @relation(fields: [planId], references: [id])
}

model Batch {
  id               String      @id @default(cuid())
  taskId           String
  trayNumber       Int
  currentDay       Int         @default(0)
  status           BatchStatus @default(SOWING)
  actualYieldGrams Int?
  harvestImageUrl  String?
  harvestedAt      DateTime?
  createdAt        DateTime    @default(now())
  task             Task        @relation(fields: [taskId], references: [id])
  checkIns         CheckIn[]
  payout           Payout?
}

model CheckIn {
  id           String    @id @default(cuid())
  batchId      String
  day          Int
  imageTopUrl  String?
  imageSideUrl String?
  notes        String?
  qcResult     QCResult?
  qcNotes      String?
  qcReviewedAt DateTime?
  qcReviewedBy String?
  createdAt    DateTime  @default(now())
  batch        Batch     @relation(fields: [batchId], references: [id])
}

model Cluster {
  id       String   @id @default(cuid())
  name     String
  city     String
  lat      Float
  lng      Float
  radiusKm Float    @default(3.0)
  growers  Grower[]
  hubs     Hub[]
}

model Hub {
  id           String     @id @default(cuid())
  name         String
  address      String
  clusterId    String
  lat          Float
  lng          Float
  dropoffStart String
  dropoffEnd   String
  isActive     Boolean    @default(true)
  deliveries   Delivery[]
  cluster      Cluster    @relation(fields: [clusterId], references: [id])
}

model Delivery {
  id           String         @id @default(cuid())
  orderId      String         @unique
  hubId        String
  status       DeliveryStatus @default(PREPARING)
  driverName   String?
  driverPhone  String?
  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  hub          Hub            @relation(fields: [hubId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id])
}

model Feedback {
  id           String     @id @default(cuid())
  orderId      String     @unique
  restaurantId String
  rating       Int
  notes        String?
  imageUrl     String?
  createdAt    DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model Payout {
  id        String       @id @default(cuid())
  growerId  String
  batchId   String       @unique
  amount    Float
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  batch     Batch        @relation(fields: [batchId], references: [id])
  grower    Grower       @relation(fields: [growerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  GROWER
  RESTAURANT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  AT_HUB
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  HARVEST_READY
  HARVESTED
  CANCELLED
}

enum BatchStatus {
  SOWING
  GROWING
  PRE_HARVEST
  QC_PENDING
  QC_PASSED
  QC_FAILED
  HARVESTED
  REJECTED
}

enum QCResult {
  PASS
  RISK
  REJECT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum DeliveryStatus {
  PREPARING
  PACKED
  IN_TRANSIT
  DELIVERED
  FAILED
}
