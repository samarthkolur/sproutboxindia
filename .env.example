# ── Database (PostgreSQL via Prisma) ──────────────────────────────────────────
DATABASE_URL=""

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Uploadthing ───────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=""

# ── Analytics (Google Analytics 4) ────────────────────────────────────────────
# A/B experiment results are reported through GA4 — see EXPERIMENTS.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── A/B experiments ───────────────────────────────────────────────────────────
# ?sb_force=<experiment>:<variant> always works outside production.
# Set to "true" to also allow it in production (for QA on the live site).
ALLOW_FORCE_VARIANT=""
